{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ai-Manager",
  "version": "1.21.0",
  "identifier": "com.adaalif.ai-manager",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 340,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/adaalif/ai-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
